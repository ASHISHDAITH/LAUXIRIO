# Copy this file to .env and provide values from your salon and database provider.
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=
SALON_LOCATIONS_JSON=
SALON_STYLISTS_JSON=
SALON_WEEKLY_AVAILABILITY_JSON=
SALON_SERVICE_DURATION_MINUTES_JSON=
SALON_TIME_ZONE=
ADMIN_API_TOKEN=

# Optional appointment notification via Resend (only configured verified senders).
RESEND_API_KEY=
SALON_NOTIFICATION_EMAIL=
EMAIL_FROM=

# Optional: licensed, silent hero campaign film.
# Save a compressed MP4/WebM in public/media/video/ and set its public URL path.
# Leave unset to keep the still-image hero.
# NEXT_PUBLIC_LAUXIRIO_HERO_VIDEO_SRC=/media/video/lauxirio-hero.mp4
